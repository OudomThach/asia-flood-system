# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMS Gateway (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
DEFAULT_EMERGENCY_PHONE=

# Ingestion Interval (Seconds, default 1800 = 30 mins)
AUTO_SCHEDULE_INTERVAL_SECONDS=1800

# NASA FIRMS active-fire feed (optional). Get a free key at:
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Without it, wildfires still come through NASA EONET; with it, you also get
# near-real-time VIIRS satellite fire detections on the live hazard layer.
FIRMS_MAP_KEY=
